<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StageCraft"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- W5：Core 独立进程服务（计划 §2.2/§4.2）。主进程 bindService(BIND_AUTO_CREATE) 创建并持有；
             绝不承载主 UI；崩溃由主进程经 onServiceDisconnected/death recipient 感知并进入恢复页。 -->
        <service
            android:name=".CoreService"
            android:exported="false"
            android:process=":core"
            android:description="@string/core_service_description" />
    </application>
</manifest>
