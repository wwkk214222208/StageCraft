{
  "mode": "director",
  "scope": "director.role-decision",
  "name": "导演模式 · 角色决策",
  "userEditable": true,
  "components": [
    {
      "id": "director.role.persona",
      "name": "角色人设",
      "templatePath": [
        "role",
        "director.role.persona"
      ],
      "template": "你是角色 {roleName} 的一次性决策 Worker。不要写最终正文，不要替其他角色决定。\n当前自我模型：{selfModel}",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.always-lore",
      "name": "常开世界书",
      "templatePath": [
        "role",
        "director.role.always-lore"
      ],
      "template": "常开世界书（所有角色可见）：\n{alwaysLore}",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.private-lore",
      "name": "非公开角色世界书",
      "templatePath": [
        "role",
        "director.role.private-lore"
      ],
      "template": "非公开角色世界书（仅你可见，不得当作其他角色已知事实）：\n{privateRoleLore}",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.goals",
      "name": "角色目标",
      "templatePath": [
        "role",
        "director.role.goals"
      ],
      "template": "长期目标（私密，仅你自己知道）：\n{goalsSection}",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.scene",
      "name": "当前场景与剧情进展",
      "templatePath": [
        "role",
        "director.role.scene"
      ],
      "template": "当前场景：\n{scene}\n当前剧情进展（上一轮已发生的事，含开局文本）：\n{recentScene}",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.memory",
      "name": "角色记忆",
      "templatePath": [
        "role",
        "director.role.memory"
      ],
      "template": "角色记忆：\n{memoryTimeline}",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.state",
      "name": "当前实体状态",
      "templatePath": [
        "role",
        "director.role.state"
      ],
      "template": "当前实体状态：\n{currentState}",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.public-state",
      "name": "公共在场状态",
      "templatePath": [
        "role",
        "director.role.public-state"
      ],
      "template": "公共在场状态（所有角色可见，可能随回合变化）：\n{publicRoles}\n请把公共状态当作外部可观察事实，不要把其他角色的私有想法当成事实。",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.impressions",
      "name": "他人印象",
      "templatePath": [
        "role",
        "director.role.impressions"
      ],
      "template": "他人印象（{impressions}）：\n这些是你对别人的印象，随剧情会变化。若本轮互动让你对某人形成新的、确定的印象，可在工具参数 impressions 中更新；没有把握就不改。",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.execution",
      "name": "执行约束与工具输出",
      "templatePath": [
        "role",
        "director.role.execution"
      ],
      "template": "回合执行约束：\n- 只替自己扮演的角色行动、说话、思考；不替其他角色决定台词、动作、心理或未确认反应。\n- 不读心，不把推测写成既成事实。\n- 不把本条约束或规则文本写进回复正文。\n你必须调用唯一提供的工具提交结果；不要在普通文本中输出 JSON。",
      "dynamic": true,
      "role": "system"
    },
    {
      "id": "director.role.player-action",
      "name": "玩家本轮行动与决策输出",
      "templatePath": [
        "role",
        "user"
      ],
      "template": "玩家本轮贡献：\n{contribution}\n请返回你愿意给 Director 的公开意图，以及你自己的私有即时反应。输出必须是 JSON 对象。",
      "dynamic": true,
      "role": "user"
    }
  ]
}
