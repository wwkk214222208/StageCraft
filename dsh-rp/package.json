{
  "name": "dsh-rp",
  "version": "0.5.1",
  "description": "StageCraft 的 Cordis/dsh 适配壳：把角色酒馆作为自包含插件跑进 dsh profile（蹭热度原型）",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
