# ── 私有数据（不上传） ──
data/
save/
providers.json
data/billing-prices.json
data/billing-stats.json
.workbuddy/
.npm-cache/
node_modules/
*.log

# ── 发布产物（不入库，GitHub Release 附件） ──
release/

# ── 用户自建内容：保留目录、忽略内容（仓库内保留 .gitkeep） ──
custom/*
!custom/.gitkeep
stories/custom/*
!stories/custom/.gitkeep

# 备份
*backup*
# 私有剧本头像
public/assets/custom/
prompts/custom/*
!prompts/custom/.gitkeep

# ── WSL 启动/关闭脚本（本地使用，不纳入版本控制） ──
start-wsl.bat
start-wsl.ps1
wsl-start.sh
wsl-stop.sh
close-wsl.bat

